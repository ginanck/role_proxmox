#jinja2: lstrip_blocks: "True"
# network interface settings; autogenerated
# Please do NOT modify this file directly, unless you know what
# you're doing.
#
# If you want to manage parts of the network configuration manually,
# please utilize the 'source' or 'source-directory' directives to do
# so.
# PVE will preserve these directives, but will NOT read its network
# configuration from sourced files, so do not attempt to move any of
# the PVE managed interfaces into external files!

source /etc/network/interfaces.d/*

auto lo
iface lo inet loopback
iface lo inet6 loopback

{% for item in proxmox_network_interfaces.interfaces if item.is_primary|default(false) %}
auto {{ proxmox_network_interfaces.primary_interface }}
iface {{ proxmox_network_interfaces.primary_interface }} inet manual
        up route add -net {{ item.ipv4.network }} netmask {{ item.ipv4.netmask }} gw {{ item.ipv4.gateway }} dev {{ proxmox_network_interfaces.primary_interface }}

auto {{ item.name }}
iface {{ item.name }} inet static
        address {{ item.ipv4.address }}
        gateway {{ item.ipv4.gateway }}
        bridge-ports {{ proxmox_network_interfaces.primary_interface }}
        bridge-stp off
        bridge-fd 0
{% if item.comment is defined %}
#{{ item.comment }}
{% endif %}

iface {{ item.name }} inet6 static
        address {{ item.ipv6.address }}
        gateway {{ item.ipv6.gateway }}
{% endfor %}

{% for item in proxmox_network_interfaces.interfaces if not item.is_primary|default(false) %}
auto {{ item.name }}
iface {{ item.name }} inet manual
        bridge-ports none
        bridge-stp off
        bridge-fd 0
    {% if item.vlan_aware is defined and item.vlan_aware %}
        bridge-vlan-aware yes
        bridge-vids {{ item.vids }}
    {% endif %}
{% if item.comment is defined %}
#{{ item.comment }}
{% endif %}

{% endfor %}
